# Base URL of the CRM control plane (the Next.js app). The worker calls its
# /api/internal/voice/* endpoints to fetch call context and post transcripts.
APP_URL=http://127.0.0.1:3000

# Shared secret for authenticating inbound-start calls to the CRM. MUST match
# VOICE_SERVICE_SECRET set on the CRM.
VOICE_SERVICE_SECRET=

# LiveKit Cloud project. The worker dials OUT to this URL to receive call jobs;
# LiveKit Cloud runs the SIP + real-time media. Get these from the LiveKit
# Cloud dashboard (Settings -> Keys).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Must match the agent_name used in the LiveKit inbound dispatch rule and in the
# CRM's outbound dispatch (lib/livekit-voice.ts).
VOICE_AGENT_NAME=voice-inquiry-agent

# Optional Sarvam model overrides.
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v2
