# Base URL of the CRM control plane (the Next.js app). The media service calls
# its /api/internal/voice/* endpoints to fetch call context and post transcripts.
APP_URL=http://127.0.0.1:3000

# Port to listen on (Plivo connects to wss://<host>:<PORT>/ws).
PORT=8080

# Optional model overrides.
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v2
