DATABASE_URL=
DIRECT_URL=
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
ENCRYPTION_KEY="replace-with-a-32-byte-or-longer-secret"
PLATFORM_ADMIN_EMAIL=""
PLATFORM_ADMIN_PASSWORD=""
APP_URL="http://127.0.0.1:3000"
CORS_ORIGIN="http://127.0.0.1:3000"
EGRESS_SAFE_MODE="false"

# The Google Sheet lead auto-sync scheduler is skipped automatically when DATABASE_URL
# is empty (so local UI work boots cleanly). Set this to "true" to also disable it
# even when a database IS configured.
LEAD_SHEET_AUTO_SYNC_DISABLED="false"

# How often the scheduler polls the sheet, in milliseconds. Default 30000 (30s),
# clamped to 5000-300000. Lower values pick leads up sooner but cost Google Sheets
# API quota and database egress on every tick.
LEAD_SHEET_SYNC_INTERVAL_MS="30000"

# Retention for `npm run cleanup:logs`, which prunes AuditLog rows older than this
# many days. Default 90.
AUDIT_LOG_RETENTION_DAYS="90"

# --- Global Skin Care: call-transcript appointment follow-up (company-specific) ---
# For the Global Skin Care tenant only, call transcripts + phone numbers are stored in a
# Google Sheet tab. The AI reads each transcript, extracts the scheduled appointment, and
# sends the appointment follow-up WhatsApp template. Configure the approved template in that
# company's "Broadcast & Campaign Templates" integration under the
# "Appointment Follow-up (Global Skin Care)" group (APPOINTMENT_FOLLOWUP_TEMPLATE_NAME, etc.),
# mapping a variable to lead.appointment for the detected date/time.
#
# The tenant is matched by slug or name (any of "Global Skin Care" / "global-skin-care" /
# "globalskincare"). Override or add matches with a comma-separated list if the slug differs:
GLOBAL_SKINCARE_TENANT_SLUG=""
# Tab holding the transcripts (default: call_transcripts). Expected columns: phone, name,
# transcript (and optionally an explicit appointment column and a status column).
GLOBAL_SKINCARE_TRANSCRIPT_TAB="call_transcripts"
# When set to N, the follow-up is only sent once the appointment is within N hours (a
# pre-appointment reminder). Leave empty (default) to send immediately once the appointment
# is detected.
GLOBAL_SKINCARE_APPOINTMENT_REMINDER_LEAD_HOURS=""
# Optional tuning:
GLOBAL_SKINCARE_APPOINTMENT_SEND_GAP_MS="6000"
GLOBAL_SKINCARE_APPOINTMENT_MAX_PER_RUN="50"
GLOBAL_SKINCARE_APPOINTMENT_MAX_FAILURES="2"

# --- Request-a-demo form storage (Google Sheet in Google Drive) ---
# Until these are set, submissions are written to .data/demo-requests.jsonl locally.
# Create a Google service account, share the target sheet with its email, and paste values below.
DEMO_REQUEST_SHEET_ID=""
DEMO_REQUEST_SHEET_TAB="Demo Requests"
DEMO_REQUEST_GOOGLE_SERVICE_ACCOUNT_EMAIL=""
DEMO_REQUEST_GOOGLE_PRIVATE_KEY=""
