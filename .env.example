DATABASE_URL=
DIRECT_URL=
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
ENCRYPTION_KEY="replace-with-a-32-byte-or-longer-secret"
PLATFORM_ADMIN_EMAIL=""
PLATFORM_ADMIN_PASSWORD=""
APP_URL="http://127.0.0.1:3000"
CORS_ORIGIN="http://127.0.0.1:3000"
EGRESS_SAFE_MODE="false"

# The Google Sheet lead auto-sync scheduler is skipped automatically when DATABASE_URL
# is empty (so local UI work boots cleanly). Set this to "true" to also disable it
# even when a database IS configured.
LEAD_SHEET_AUTO_SYNC_DISABLED="false"

# --- Request-a-demo form storage (Google Sheet in Google Drive) ---
# Until these are set, submissions are written to .data/demo-requests.jsonl locally.
# Create a Google service account, share the target sheet with its email, and paste values below.
DEMO_REQUEST_SHEET_ID=""
DEMO_REQUEST_SHEET_TAB="Demo Requests"
DEMO_REQUEST_GOOGLE_SERVICE_ACCOUNT_EMAIL=""
DEMO_REQUEST_GOOGLE_PRIVATE_KEY=""
